# 复制为 .env (本地) 或在 Koyeb/Render 后台逐项填入环境变量

# 数据库：本地自测用 SQLite 文件；生产用 Turso(持久、免费、免信用卡)
# 本地：
DATABASE_URL=file:local.db
# 生产(Turso)：把上面注释掉，改用下面两行(值从 Turso 控制台获取)
# DATABASE_URL=libsql://你的库名-用户名.turso.io
# DATABASE_AUTH_TOKEN=你的_turso_token

# 管理后台账号(首次初始化写入；之后改库或在后台改密码)
ADMIN_USER=admin
ADMIN_PASSWORD=请改成强密码

# 客户端 API 密钥(留空则首次初始化随机生成并在日志打印一次)
# API_KEY=SK_xxxxxxxxxxxxxxxx

# JWT 密钥(管理后台登录令牌签名)。生产务必设成 32+ 位随机串
JWT_SECRET=请用 openssl rand -hex 32 生成

# 授权令牌签名【私钥】(Ed25519, PEM/PKCS8)。服务端独占,绝不下发;守护内嵌对应公钥离线验签。
# 生成: openssl genpkey -algorithm ed25519 -out priv.pem  (把 priv.pem 全文粘进此变量, 含 BEGIN/END 行)
# 注: 公钥需同步更新到守护 CTS-Daemon/include/License.hpp 的 kPublicKey 数组。
LICENSE_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...粘贴 priv.pem 全文...\n-----END PRIVATE KEY-----"

# 令牌有效期(天)= 离线最长宽限。在线时 App 每 12h/每次打开自动续期,正常用户滚动不到期;
# 此值只影响"一直离线"的用户多久后守护自动停机。30=离线最多撑 30 天,一联网即刻重新校验/吊销。
LICENSE_TOKEN_TTL_DAYS=30

# 端口(Koyeb/Render 会注入 PORT，本地默认 3000)
# PORT=3000
